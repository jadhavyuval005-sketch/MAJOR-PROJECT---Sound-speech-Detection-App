# Copy to .env (never commit it).
# Development uses SQLite and local audio storage when these are unset.

JWT_SECRET_KEY=replace-with-a-long-random-string      # python -c "import secrets; print(secrets.token_hex(32))"

# MySQL on Amazon RDS
DATABASE_URL=mysql+pymysql://ssd_user:PASSWORD@your-db.xxxx.ap-south-1.rds.amazonaws.com:3306/ssd

# S3 for recordings (EC2 instance role supplies credentials)
S3_BUCKET=your-ssd-recordings-bucket
AWS_REGION=ap-south-1

# CloudWatch Logs
CLOUDWATCH_LOG_GROUP=/ssd-screener/app

# quality = signal checks + manual marking; wav2vec2 = automatic phoneme scoring (needs torch, transformers)
ANALYZER=quality
CORS_ORIGINS=http://localhost:5173
